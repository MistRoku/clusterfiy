# Production template. Copy to .env on the server and fill in secrets.
# Never commit the real .env.
APP_NAME=Clusterfiy
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.example.com

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=clusterfiy
DB_USERNAME=clusterfiy
DB_PASSWORD=change-me

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# Real transactional mail (Postmark free tier: 100 emails/month).
# Alternative demo-only option: MAIL_MAILER=log (no email actually leaves
# the server; acceptable only if the live demo does not need invites).
MAIL_MAILER=failover
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_HOST=smtp.postmarkapp.com
MAIL_PORT=587
MAIL_USERNAME=postmark-api-token
MAIL_PASSWORD=change-me
MAIL_ENCRYPTION=tls
POSTMARK_API_KEY=change-me

STRIPE_KEY=pk_live_...
STRIPE_SECRET=sk_live_...
STRIPE_TEAM_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...
